# Bu dosyayı `.env` adıyla kopyala (backend/ içinde). `.env` git'e girmez.

# Dinlenecek adres (host:port).
ADDR=127.0.0.1:8080

# LLM: https://openrouter.ai/keys ve openrouter.ai/models'ten model kimliği
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Görsel: https://fal.ai/dashboard/keys
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_EDIT_MODEL=fal-ai/nano-banana/edit
FAL_SPEECH_MODEL=fal-ai/wizper

# Hesaplar ve kütüphane (Supabase). Servis anahtarı yalnız sunucuda durur, tarayıcıya girmez.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Yerelde Supabase olmadan denemek için: bellekte hesaplar, kapanınca silinir. Canlıda asla.
# DREAMLIB_DEV_AUTH=1
# Ücretli anahtar olmadan yerelde: yorum, kitapçık ve ses örnek cevaplarla çalışır. DEV_AUTH ile birlikte; canlıda asla.
# DREAMLIB_FAKE_AI=1

# Arka plan işleri (kitapçık, görsel). API süreci aynı anda bu kadar iş çizer;
# 0 yazılırsa işleri ayrı süreçte `python -m app.worker` yürütür.
# DREAMLIB_WORKERS=2
# 24 saatte başlatılabilecek iş sayısı; 0 sınırsız.
# DAILY_LIMIT_GUEST=3
# DAILY_LIMIT_USER=10
# Yorum (clean, analyze, transcribe) ve panel yenileme hakları, 24 saatte; 0 sınırsız.
# DAILY_TEXT_GUEST=30
# DAILY_TEXT_USER=100
# DAILY_REDO_GUEST=10
# DAILY_REDO_USER=30
