{
  "name": "dreamlib",
  "private": true,
  "description": "Dreamlib: frontend/ (React + Vite) ve backend/ (Python FastAPI). Kök yalnız görev çalıştırıcıdır, bağımlılık yok.",
  "scripts": {
    "setup": "powershell -NoProfile -File scripts/setup.ps1",
    "dev": "powershell -NoProfile -File scripts/dev.ps1",
    "check": "powershell -NoProfile -File scripts/check.ps1",
    "test:db": "python scripts/db_test.py",
    "db": "python scripts/local_db.py",
    "dreamlib": "python scripts/local_db.py app",
    "dreamlib:stop": "python scripts/local_db.py down",
    "dreamlib:logs": "python scripts/local_db.py logs",
    "start": "python scripts/local_db.py app"
  }
}
