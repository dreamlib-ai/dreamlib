{
  "name": "dreamlib-app",
  "account_id": "cb3b3a4f6f408f6bf04b874245def0e1",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "dreamlib.cenker.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": { "API_ORIGIN": "https://dreamlib-api-production.up.railway.app" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
